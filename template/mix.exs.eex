defmodule <%= @module_name %>.MixProject do
  use Mix.Project

  @app :<%= @app_name %>
  @version Path.join(__DIR__, "VERSION")
           |> File.read!()
           |> String.trim()
  @description "Nerves Toolchain - <%= @target_display %>"
  @source_url "https://github.com/nerves-project/toolchains"

  def project do
    [
      app: @app,
      version: @version,
      elixir: "~> 1.13",
      description: @description,
      package: package(),
      source_url: @source_url,
      nerves_package: nerves_package(),
      deps: deps(),
      docs: docs()
    ]
  end

  def application do
    []
  end

  def cli do
    [
      preferred_envs: %{docs: :docs, "hex.publish": :docs, "hex.build": :docs},
      default_target: :target
    ]
  end

  defp nerves_package do
    [
      type: :toolchain,
      platform: <%= @module_name %>,
      target_tuple: :<%= @target_tuple %>,
      artifact_sites: [
        {:github_releases, "nerves-project/toolchains"}
      ],
      checksum: checksum_files()
    ]
  end

  defp deps do
    [
      {:ex_doc, "~> 0.22", only: :docs, runtime: false},
      {:nerves, "~> 1.13 or ~> 2.0.0-pre.9", runtime: false}
    ]
  end

  defp package do
    [
      files: package_files(),
      licenses: [
        <%= @package_licenses_list %>
      ],
      links: %{
        "Github" => "https://github.com/nerves-project/toolchains/tree/main/#{@app}"
      }
    ]
  end

  defp docs do
    [
      extras: ["README.md"],
      main: "readme"
    ]
  end

  defp package_files do
    [
      "README.md",
      "LICENSE",
      "lib",
      "mix.exs",
      "VERSION"
    ] ++ checksum_files()
  end

  # Reserved for legacy compatibility archive aliases.
  defp checksum_files do
    [
      "toolchain.exs"
    ]
  end
end
