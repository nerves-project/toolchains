CT_LOCAL_TARBALLS_DIR="${HOME}/.nerves/dl"
CT_ARCH_ARM=y
CT_ARCH_64=y
CT_CANADIAN=y
CT_HOST="x86_64-w64-mingw32"
# CT_STRIP_HOST_TOOLCHAIN_EXECUTABLES is not set
CT_KERNEL_LINUX=y
CT_LINUX_V_6_12=y
CT_LIBC_GLIBC=y
CT_GLIBC_KERNEL_VERSION_CHOSEN=y
CT_GLIBC_MIN_KERNEL_VERSION="6.12.0"
CT_GCC_V_16=y
CT_DEBUG_GDB=y
