CT_LOCAL_TARBALLS_DIR="${HOME}/.nerves/dl"
CT_ARCH_ARM=y
CT_ARCH_CPU="generic-armv7-a"
CT_ARCH_SUFFIX="v7"
CT_ARCH_FPU="vfpv3-d16"
CT_ARCH_FLOAT_HW=y
CT_KERNEL_LINUX=y
CT_LINUX_V_6_12=y
CT_LIBC_GLIBC=y
CT_GLIBC_KERNEL_VERSION_CHOSEN=y
CT_GLIBC_MIN_KERNEL_VERSION="6.12.0"
CT_GCC_V_16=y
CT_DEBUG_GDB=y
