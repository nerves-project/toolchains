CT_EXPERIMENTAL=y
CT_LOCAL_TARBALLS_DIR="${HOME}/.nerves/dl"
CT_ARCH_RISCV=y
CT_MULTILIB=y
CT_ARCH_USE_MMU=y
CT_ARCH_64=y
CT_ARCH_ARCH="rv64gc"
CT_KERNEL_LINUX=y
CT_LINUX_V_6_12=y
CT_LIBC_GLIBC=y
CT_GLIBC_KERNEL_VERSION_CHOSEN=y
CT_GLIBC_MIN_KERNEL_VERSION="6.12.0"
CT_GCC_V_16=y
# CT_CREATE_LDSO_CONF is not set
CT_DEBUG_GDB=y
