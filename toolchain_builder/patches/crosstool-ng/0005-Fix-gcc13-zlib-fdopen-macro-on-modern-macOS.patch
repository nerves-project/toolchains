Subject: [PATCH] Fix GCC 13 zlib fdopen macro on modern macOS

Apply the same Darwin guard used for binutils and GDB to GCC 13.5.0's
bundled zlib.

diff --git a/packages/gcc/13.5.0/0001-Fix-zlib-fdopen-macro-conflict-on-modern-macOS.patch b/packages/gcc/13.5.0/0001-Fix-zlib-fdopen-macro-conflict-on-modern-macOS.patch
new file mode 100644
--- /dev/null
+++ b/packages/gcc/13.5.0/0001-Fix-zlib-fdopen-macro-conflict-on-modern-macOS.patch
@@ -0,0 +1,24 @@
+Subject: [PATCH] Fix zlib fdopen macro conflict on modern macOS
+
+GCC 13's bundled zlib defines fdopen as NULL when it detects support
+for older Macs. On modern Darwin this conflicts with the declaration
+in the system stdio.h header, causing zutil.c to fail to compile.
+
+Keep the legacy fallback, but do not define fdopen on modern Darwin.
+
+---
+ zlib/zutil.h | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/zlib/zutil.h b/zlib/zutil.h
+--- a/zlib/zutil.h
++++ b/zlib/zutil.h
+@@ -136,7 +136,7 @@
+ #    if defined(__MWERKS__) && __dest_os != __be_os && __dest_os != __win32_os
+ #      include <unix.h> /* for fdopen */
+ #    else
+-#      ifndef fdopen
++#      if !defined(fdopen) && !(defined(__APPLE__) && defined(__MACH__))
+ #        define fdopen(fd,mode) NULL /* No fdopen() */
+ #      endif
+ #    endif
